# Copy this file to a new file called .env and change the values.
# .env is never committed to git, so your secrets stay on your computer.

# Secret key used to sign login tokens (JWTs). Use a long random text, at least 32 characters.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-characters

# Password for the users created the first time, when the database is empty.
SEED_PASSWORD=password

# Set to true to also create example users: Bo and Majland (SuperUser), Bent and Gert (User).
SEED_USERS=true
